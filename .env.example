# ---- 공통 ----
NODE_ENV=development
APP_URL=http://localhost:3000          # 프론트엔드 주소 (OAuth 리다이렉트 후 복귀)
API_URL=http://localhost:4000          # API 서버 주소 (서버 간 호출)
API_PORT=4000

# ---- 데이터베이스 (docker compose db 서비스 기준) ----
DATABASE_URL=postgresql://routinebox:routinebox@localhost:5432/routinebox?schema=public
POSTGRES_USER=routinebox
POSTGRES_PASSWORD=routinebox
POSTGRES_DB=routinebox

# ---- 인증 ----
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
COOKIE_SECURE=false                    # 운영(HTTPS)에서는 true

# ---- 소셜 로그인 (개발자 콘솔에서 발급) ----
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---- 결제 (토스페이먼츠 테스트 키, 3주차) ----
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
BILLING_KEY_ENCRYPTION_KEY=            # 32바이트 hex (openssl rand -hex 32)

# ---- 이메일 (4주차) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RoutineBox <no-reply@example.com>

# ---- 프론트엔드 (apps/web/.env.local) ----
NEXT_PUBLIC_API_BASE=/api
API_INTERNAL_URL=http://localhost:4000  # Next.js rewrite 대상
