# 루틴박스 환경 변수 — 이 파일을 복사한 루트 .env 하나만 사용한다 (apps/* 아래에는 두지 않는다).
# API·Prisma·Next.js·Docker Compose 모두 루트 .env 를 읽는다.

# ---- 공통 ----
NODE_ENV=development
APP_URL=http://localhost:3000          # 프론트엔드 주소 (OAuth 리다이렉트 후 복귀)
API_URL=http://localhost:4000          # API 서버 주소 (서버 간 호출)
API_PORT=4000

# ---- 데이터베이스 (docker compose db 서비스 기준) ----
DATABASE_URL=postgresql://routinebox:routinebox@localhost:5433/routinebox?schema=public
POSTGRES_USER=routinebox
POSTGRES_PASSWORD=routinebox
POSTGRES_DB=routinebox

# ---- 인증 ----
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
COOKIE_SECURE=false                    # 운영(HTTPS)에서는 true

# ---- 소셜 로그인 (개발자 콘솔에서 발급) ----
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- 결제 (토스페이먼츠) ----
# 개발자센터 → API 키 → "API 개별 연동 키" 탭의 테스트 키를 넣는다 (test_ck_… / test_sk_…).
# 결제위젯 연동 키(test_gck_… / test_gsk_…)는 카드 등록창·빌링키 발급에 쓸 수 없다 (NOT_SUPPORTED_WIDGET_KEY).
# .env 를 바꾸면 pnpm dev 를 다시 시작해야 반영된다 (NEXT_PUBLIC_* 는 웹 서버 시작 시 번들에 들어감).
TOSS_CLIENT_KEY=                       # test_ck_…
TOSS_SECRET_KEY=                       # test_sk_…
BILLING_KEY_ENCRYPTION_KEY=            # 32바이트 hex (openssl rand -hex 32)
PAYMENTS_MOCK=true                     # 개발용 모의 결제수단 허용 (운영에서는 false)

# ---- 이메일 (4주차) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RoutineBox <no-reply@example.com>

# ---- 프론트엔드 (Next.js, 같은 루트 .env) ----
NEXT_PUBLIC_API_BASE=/api
API_INTERNAL_URL=http://localhost:4000  # Next.js rewrite 대상
NEXT_PUBLIC_TOSS_CLIENT_KEY=           # TOSS_CLIENT_KEY 와 같은 값 (test_ck_…, 카드 등록창)
NEXT_PUBLIC_PAYMENTS_MOCK=true         # 화면에 "테스트 카드 등록" 버튼 표시
