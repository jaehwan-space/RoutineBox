{
  "name": "routinebox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @routinebox/api prisma:migrate",
    "db:studio": "pnpm --filter @routinebox/api prisma:studio",
    "db:seed": "pnpm --filter @routinebox/api db:seed"
  }
}
