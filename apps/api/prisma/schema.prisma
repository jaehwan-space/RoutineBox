generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  KAKAO
  GOOGLE
}

enum Category {
  DETERGENT
  TISSUE
  WATER
  COFFEE
  KITCHEN
  PET
  SALAD_MEAL
  FRUIT_NUT_RICE
  SOUP_SIDE_MAIN
  MEAT_EGG
  BAKERY_CHEESE_DELI
  SEAFOOD
  SNACK
  HEALTH
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  PAYMENT_FAILED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PREPARING
  SHIPPED
  DELIVERED
}

enum PaymentStatus {
  APPROVED
  FAILED
}

enum NotificationType {
  SUBSCRIPTION_STARTED
  BILLING_D1
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SHIPPED
  SKIPPED
  CANCELLED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String?
  name           String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  oauthAccounts  OAuthAccount[]
  refreshTokens  RefreshToken[]
  cartItems      CartItem[]
  paymentMethods PaymentMethod[]
  subscriptions  Subscription[]
  orders         Order[]
  notifications  Notification[]
}

model OAuthAccount {
  id         String       @id @default(cuid())
  provider   AuthProvider
  providerId String
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Product {
  id                   String         @id @default(cuid())
  name                 String
  description          String         @default("")
  category             Category
  price                Int
  subscriptionDiscount Int            @default(5)
  recommendedCycleDays Int            @default(28)
  stock                Int            @default(0)
  imageUrl             String?
  isActive             Boolean        @default(true)
  // 상세 정보 (외부 데이터 임포트 시 채워짐)
  externalId           String?        @unique
  brand                String?
  detailDescription    String         @default("")
  detailImages         String[]       @default([])
  weight               String?
  unitOfSale           String?
  packagingType        String?
  deliveryType         String?
  origin               String?
  allergy              String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  cartItems            CartItem[]
  subscriptions        Subscription[]

  @@index([category, isActive])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model PaymentMethod {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerKey   String
  billingKeyEnc String
  cardCompany   String
  cardLast4     String
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?
  subscriptions Subscription[]

  @@index([userId])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  productId         String
  product           Product            @relation(fields: [productId], references: [id])
  paymentMethodId   String?
  paymentMethod     PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  quantity          Int
  cycleDays         Int
  amount            Int
  status            SubscriptionStatus @default(PENDING)
  firstDeliveryDate DateTime           @db.Date
  nextBillingDate   DateTime?          @db.Date
  nextRetryAt       DateTime?
  failCount         Int                @default(0)
  pausedAt          DateTime?
  cancelledAt       DateTime?
  cancelledReason   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]
  notifications     Notification[]

  @@index([userId, status])
  @@index([status, nextBillingDate])
  @@index([status, nextRetryAt])
}

model Order {
  id             String         @id @default(cuid())
  subscriptionId String
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  orderKey       String         @unique
  amount         Int
  quantity       Int
  status         OrderStatus    @default(PENDING)
  deliveryStatus DeliveryStatus @default(PREPARING)
  billingDate    DateTime       @db.Date
  deliveryDate   DateTime       @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  payment        Payment?

  @@index([userId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  paymentKey  String?
  status      PaymentStatus
  amount      Int
  approvedAt  DateTime?
  failReason  String?
  rawResponse Json?
  createdAt   DateTime      @default(now())
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id])
  type           NotificationType
  periodKey      String?
  sentAt         DateTime         @default(now())

  @@unique([subscriptionId, type, periodKey])
  @@index([userId, sentAt])
}
